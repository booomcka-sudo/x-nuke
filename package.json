{
  "name": "x-nuke",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json",
    "build:all": "pnpm build && pnpm --filter @xn/extension build",
    "start": "node dist/apps/api/src/index.js",
    "start:worker": "node dist/apps/worker/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "deploy:prepare": "pnpm db:migrate && pnpm user:bootstrap",
    "user:create": "tsx apps/api/src/cli.ts user",
    "labels:import": "tsx apps/api/src/cli.ts labels",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "zip": "node scripts/zip.mjs",
    "user:bootstrap": "tsx apps/api/src/bootstrap.ts",
    "test:db": "node scripts/test-db.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/jwt": "10.0.0",
    "@fastify/rate-limit": "10.3.0",
    "bullmq": "5.61.2",
    "drizzle-orm": "0.44.6",
    "fastify": "5.6.2",
    "ioredis": "5.8.1",
    "pg": "8.16.3",
    "zod": "3.25.76",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.1.24",
    "@types/node": "22.18.10",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.37.0",
    "typescript-eslint": "8.46.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "archiver": "7.0.1"
  }
}
